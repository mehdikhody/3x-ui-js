{
    "exclude": ["node_modules", "build"],
    "include": ["src", "tests"],
    "compilerOptions": {
        "strict": true,
        "module": "nodenext",
        "target": "esnext",
        "moduleResolution": "nodenext",
        "outDir": "build",
        "rootDirs": ["src"],
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "declaration": true,
        "lib": ["ESNext"],
        "paths": {
            "3x-ui": ["./src/index.ts"],
            "3x-ui/*": ["./src/*"]
        }
    }
}
